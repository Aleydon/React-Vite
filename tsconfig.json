{
	"compilerOptions": {
		"jsx": "react-jsx",
		"target": "es2017",
		"module": "esnext",
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"types": ["node", "jest", "@testing-library/jest-dom"],
		"paths": {
			"@/*": ["./src/*"]
		},
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true
	},
	"include": ["src/**/*", "tests/**/*"]
}
